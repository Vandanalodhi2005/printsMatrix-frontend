# ── MIME Types ──────────────────────────────────────────────────────────────
# Critical: Apache on cPanel sometimes misidentifies .js files as text/html.
# Explicitly declare MIME types so browser ES module loading (type="module") works.
<IfModule mod_mime.c>
  AddType application/javascript  .js  .mjs
  AddType text/css                .css
  AddType image/webp              .webp
  AddType image/svg+xml           .svg
  AddType font/woff2              .woff2
  AddType font/woff               .woff
  AddType image/x-icon            .ico
</IfModule>

# ── Cache Headers ────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Images and multimedia
  ExpiresByType image/jpg          "access plus 1 year"
  ExpiresByType image/jpeg         "access plus 1 year"
  ExpiresByType image/gif          "access plus 1 year"
  ExpiresByType image/png          "access plus 1 year"
  ExpiresByType image/webp         "access plus 1 year"
  ExpiresByType image/svg+xml      "access plus 1 year"
  ExpiresByType image/x-icon       "access plus 1 year"

  # CSS and JavaScript
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"

  # Web fonts
  ExpiresByType font/woff2         "access plus 1 year"
  ExpiresByType font/woff          "access plus 1 year"
  ExpiresByType font/ttf           "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|webp|png|jpg|jpeg|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Force correct Content-Type for JS so strict MIME checking passes
  <FilesMatch "\.(js|mjs)$">
    Header set Content-Type "application/javascript"
  </FilesMatch>
</IfModule>

# ── SPA Routing (React Router) ───────────────────────────────────────────────
# Serve index.html for any path that isn't a real file/directory.
# This is what makes /complete-setup, /installation-failed etc. work on refresh.
<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # 1. Never rewrite requests that are already index.html
  RewriteRule ^index\.html$ - [L]

  # 2. If directory exists with index.html, serve it directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)/$ $1/index.html [L]

  # 3. Explicitly pass through ALL /assets/ requests — never serve index.html for chunks
  RewriteRule ^assets/ - [L]

  # 4. Pass through any URL ending in a known static file extension
  RewriteRule \.(js|mjs|css|png|jpg|jpeg|gif|svg|ico|woff2|woff|ttf|webp|json|map)$ - [L]

  # 5. SPA fallback — only reaches here if none of the above matched
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
