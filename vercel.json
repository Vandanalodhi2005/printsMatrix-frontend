{
    "rewrites": [
        { "source": "/model-search", "destination": "/model-search.html" },
        { "source": "/model-search/*", "destination": "/model-search.html" },
        { "source": "/printer-setup-guide", "destination": "/printer-setup-guide.html" },
        { "source": "/printer-setup-guide/*", "destination": "/printer-setup-guide.html" },
        { "source": "/complete-setup", "destination": "/complete-setup.html" },
        { "source": "/complete-setup/*", "destination": "/complete-setup.html" },
        { "source": "/installation-failed", "destination": "/installation-failed.html" },
        { "source": "/installation-failed/*", "destination": "/installation-failed.html" },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "headers": [{
            "source": "/assets/(.*)",
            "headers": [{
                "key": "Cache-Control",
                "value": "public, max-age=31536000, immutable"
            }]
        },
        {
            "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|gif|ico|avif)",
            "headers": [{
                "key": "Cache-Control",
                "value": "public, max-age=31536000, immutable"
            }]
        },
        {
            "source": "/(.*)\\.(css|js)",
            "headers": [{
                "key": "Cache-Control",
                "value": "public, max-age=31536000, immutable"
            }]
        }
    ]
}